      );
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn() && isValidId(bookId) &&
        isValidJilidBook(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        isAdmin();
      allow update: if isSignedIn() && isValidId(bookId) &&
        isValidJilidBook(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(bookId) && isAdmin();
    }

    match /jilidProgress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId) && (
        existing().uid == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(progressId) &&
        isValidJilidProgress(incoming()) &&
        incoming().uid == request.auth.uid &&
        exists(/databases/$(database)/documents/jilidBooks/$(incoming().bookId));
      allow update: if isSignedIn() && isValidId(progressId) &&
        isValidJilidProgress(incoming()) && (
          isAdmin() ||
