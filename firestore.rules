            existing().uid == request.auth.uid &&
            incoming().uid == existing().uid &&
            incoming().bookId == existing().bookId &&
            incoming().studentNis == existing().studentNis &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastPageRead', 'totalPages', 'updatedAt', 'serverUpdatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(progressId) && isAdmin();
    }

    match /jadwal_mapel/{jadwalId} {
      allow get: if isSignedIn() && isValidId(jadwalId) && (
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        resource.data.kelas in [
          'X RPL', 'X TKJ', 'X AK', 'X TP 1', 'X TP 2',
          'XI RPL', 'XI TKJ', 'XI AK', 'XI TP 1', 'XI TP 2',
          'XII RPL', 'XII TKJ'
        ]
      );
      allow create: if isSignedIn() && isValidId(jadwalId) &&
        isValidJadwalMapel(incoming()) &&
        incoming().id == jadwalId &&
        incoming().authorUid == request.auth.uid &&
        isAdmin();
      allow update: if isSignedIn() && isValidId(jadwalId) &&
        isValidJadwalMapel(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(jadwalId) && isAdmin();
    }

    match /prota/{protaId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isValidId(protaId) &&
        isValidProtaItem(incoming()) &&
        incoming().id == protaId &&
        incoming().authorUid == request.auth.uid &&
        isAdmin();
      allow update: if isSignedIn() && isValidId(protaId) &&
        isValidProtaItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(protaId) && isAdmin();
    }

    match /notifikasi/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId) && (
        isAdmin() ||
        existing().recipientTag in ['siswa_X', 'siswa_XI', 'siswa_XII']
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        resource.data.recipientTag in ['siswa_X', 'siswa_XI', 'siswa_XII']
      );
      allow create: if isSignedIn() && isValidId(notifId) &&
        isValidNotifikasi(incoming()) &&
        incoming().id == notifId &&
        incoming().senderUid == request.auth.uid && (
          isAdmin() ||
          (
            incoming().recipientTag == 'guru' &&
            incoming().type == 'submission' &&
            incoming().isRead == false
          )
        );
      allow update: if isSignedIn() && isValidId(notifId) &&
        isValidNotifikasi(incoming()) &&
        incoming().id == existing().id &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(notifId) && isAdmin();
    }

    match /notifikasi_dibaca/{readId} {
      allow get: if isSignedIn() && isValidId(readId) && (
        existing().uid == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(readId) &&
        isValidNotifikasiRead(incoming()) &&
