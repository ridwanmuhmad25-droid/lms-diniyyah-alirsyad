      allow update: if isSignedIn() && isValidId(readId) &&
        isValidNotifikasiRead(incoming()) && (
          isAdmin() ||
          (
            existing().uid == request.auth.uid &&
            incoming().uid == existing().uid &&
            incoming().id == existing().id &&
            incoming().notifId == existing().notifId
          )
        );
      allow delete: if isSignedIn() && isValidId(readId) && isAdmin();
    }

    match /statistik_kelas/{kelasId} {
      allow get: if isSignedIn() && isValidId(kelasId) && (
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        resource.data.tingkat in ['X', 'XI', 'XII']
      );
      allow create: if isSignedIn() && isValidId(kelasId) &&
        isValidStatistikKelas(incoming()) &&
        incoming().id == kelasId &&
        incoming().authorUid == request.auth.uid &&
        isAdmin();
      allow update: if isSignedIn() && isValidId(kelasId) &&
